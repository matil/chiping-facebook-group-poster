# Required before accepting production jobs. Generate a random value of at least 32 characters.
POSTER_SHARED_SECRET=

# The Group is deliberately fixed in the service, never supplied by the caller.
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/chiping

# Persistent volume paths inside the container.
POSTER_DATA_DIR=/data
FACEBOOK_PROFILE_DIR=/data/facebook-profile

# Safety defaults. Keep true until the login session and preview have been checked.
POSTER_DRY_RUN=true
POSTER_HEADLESS=false
POSTER_PORT=8788
POSTER_MAX_ATTEMPTS=5
POSTER_RETRY_INTERVAL_MS=60000

# Optional automatic Facebook re-login. Point these at root-readable Docker secret
# files on the VM; do not put the email or password in this file.
FACEBOOK_LOGIN_EMAIL_FILE=
FACEBOOK_LOGIN_PASSWORD_FILE=
# These are host paths used only by docker-compose.secrets.yml, not credential values.
FACEBOOK_LOGIN_EMAIL_SECRET_FILE=
FACEBOOK_LOGIN_PASSWORD_SECRET_FILE=

# Only needed by the temporary local-only VNC login service.
POSTER_ENABLE_VNC=false
POSTER_VNC_PASSWORD=

# Optional. Receives JSON events when a Facebook verification/login checkpoint blocks posting.
POSTER_ALERT_WEBHOOK_URL=
